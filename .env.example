# Environment Mode (development | production)
ENV=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL or SQLite fallback)
# For local dev without Docker, defaults to SQLite automatically if omitted.
DATABASE_URL=postgresql://lenny_user:lenny_password@localhost:5432/lenny_db

# Default LLM Provider (ollama | anthropic | openai)
DEFAULT_PROVIDER=ollama

# Ollama Local LLM Configuration (Mandatory Demo Target)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM API Keys (Optional - Evaluator can switch to cloud models in UI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
